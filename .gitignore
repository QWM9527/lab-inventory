# ============================================================
#  运行时的数据目录：里面是账号密码哈希 + 物资数据 + 清理日志，
#  属于你自己的实验室数据，绝对不要提交到公开仓库
# ============================================================
data/

# 依赖 / 日志
node_modules/
*.log
npm-debug.log*

# Cloudflare 本地开发缓存（含本地测试数据库，不要提交）
.wrangler/
.dev.vars

# Pages 打包产物（由 node cloudflare/build-pages.js 生成）
dist/

# 同步工具配置（里面有 Cloudflare API 令牌，绝对不要提交）
sync.config.json

# 编辑器、系统垃圾文件
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
